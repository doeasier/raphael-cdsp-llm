# /etc/default/llama-cdsp
#
# Tunables for llama-cdsp.service. Plain systemd EnvironmentFile syntax:
# KEY=VALUE, '#' starts a comment, NO shell expansion, NO quoting needed.
# Every KEY here overrides the matching default in the unit file.
#
# Apply changes with:
#   systemctl daemon-reload && systemctl restart llama-cdsp
#   journalctl -u llama-cdsp -f
#
# The three LD_PRELOAD / backend-path variables are deliberately NOT tunable
# here: the unit sets them after reading this file, so they always win.

# ---- Model and server ----
LLAMA_MODEL=/root/models/Qwen3.5-4B-Q4_K_M.gguf
# Small model alternative (101 MB, weights fit entirely in the cDSP cache):
# LLAMA_MODEL=/root/models/smollm2-135m-q4_k_m.gguf
LLAMA_CTX=8192
# Keep one slot: the cDSP FastRPC session is shared and serialized by a mutex,
# and concurrent long generations raise the watchdog-crash risk (Stage 6).
LLAMA_SLOTS=1
# Match llama-4b.service (auto -> 8 on this 8-core device) for a fair A/B.
LLAMA_THREADS=8
LLAMA_HOST=0.0.0.0
LLAMA_PORT=8082

# ---- cDSP offload window (Stage 6 recommendation for the 4B model) ----
GGML_CDSP_MIN_ELEMS=100000
GGML_CDSP_MAX_ELEMS=3000000
# GGML_CDSP_CACHE_MB=256

# ---- Optional diagnostics (all opt-in) ----
# GGML_CDSP_BATCH=1          # Stage 7 batched RPC; no measured end-to-end win
# GGML_CDSP_PROFILE=1        # Stage 8 four-stage timers
# GGML_CDSP_SPLIT_STATS=1    # printed when the backend .so unloads
# GGML_CDSP_DEBUG=1          # VERY verbose: 2 lines per offloaded MUL_MAT;
#                            # useful once to prove offload, bad for benchmarks

# NOTE: enabling DEBUG is the cheapest way to confirm the backend is actually
# receiving MUL_MAT nodes -- grep journalctl for "[ggml-cdsp] offloaded".
